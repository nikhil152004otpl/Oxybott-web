# ==============================================================================
# OXYBOTT PLATFORM ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend Server Configuration
PORT=5000
HOST=127.0.0.1
NODE_ENV=development

# Frontend Base URL (for CORS)
CLIENT_ORIGIN=http://localhost:3000

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oxybott
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=oxybott

# SQLite Fallback / Source Path (for migration scripts)
SQLITE_DB_PATH=../../data/oxybott.db

# JWT Administrative Security
# Required: At least 32 characters in production
JWT_SECRET=oxybott_secure_jwt_secret_key_prod_2026_modern_pg_xyz987
JWT_EXPIRES_IN=24h

# Upload Directory
UPLOAD_DIR=./uploads/products

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=20

# Store Settings Defaults
DEFAULT_CURRENCY=INR
CURRENCY_SYMBOL=₹
DEFAULT_LOW_STOCK_THRESHOLD=5

# Optional SMTP Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=admin@oxybott.com

# Frontend Vite Environment Variables (VITE_ prefix)
VITE_API_URL=/api

